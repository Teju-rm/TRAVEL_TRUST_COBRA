<%- include('partials/header', { title: 'Get a Quote', navActive: 'quote' }) %>

  <section class="page-hero">
    <div class="container">
      <h1>Get a Quote</h1>
      <p class="page-subtitle">Fill out the form below and we'll find the right coverage for you.</p>
    </div>
  </section>

  <section class="section section-light">
    <div class="container form-page-layout">
      <div class="form-card" id="quoteFormCard">
        <form id="quotePageForm">
          <div class="form-group">
            <label for="fullName">Full Name <span class="required">*</span></label>
            <input type="text" id="fullName" name="fullName" placeholder="John Doe" required minlength="2">
          </div>
          <div class="form-row two-cols">
            <div class="form-group">
              <label for="zipCode">ZIP Code <span class="required">*</span></label>
              <input type="text" id="zipCode" name="zipCode" placeholder="12345" pattern="\d{5}" maxlength="5" required>
            </div>
            <div class="form-group">
              <label for="insuranceType">Insurance Type <span class="required">*</span></label>
              <select id="insuranceType" name="insuranceType" required>
                <option value="">Select type</option>
                <% if (typeof products !== 'undefined' && products.length) { %>
                  <% products.forEach(p => { %>
                    <option value="<%= p.id %>"><%= p.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="form-row two-cols">
            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone <span class="required">*</span></label>
              <input type="tel" id="phone" name="phone" placeholder="(555) 123-4567" required>
            </div>
          </div>
          <button type="submit" class="btn btn-red btn-full">Get My Quote</button>
        </form>
        <div id="quotePageResponse" class="response-area"></div>
      </div>
      <div class="form-sidebar">
        <div class="sidebar-card">
          <i class="fas fa-shield-alt"></i>
          <h4>Why TravelTrust?</h4>
          <ul>
            <li><i class="fas fa-check"></i> 160+ years of experience</li>
            <li><i class="fas fa-check"></i> 24/7 claims support</li>
            <li><i class="fas fa-check"></i> Flexible payment options</li>
            <li><i class="fas fa-check"></i> Multi-policy discounts</li>
          </ul>
        </div>
        <div class="sidebar-card">
          <i class="fas fa-phone-alt"></i>
          <h4>Call Us</h4>
          <p>Speak directly with our support team.</p>
          <strong>1-800-TRAVELERS</strong>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

