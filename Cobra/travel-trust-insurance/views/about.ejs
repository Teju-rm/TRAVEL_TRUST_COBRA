<%- include('partials/header', { title: 'About Us', navActive: 'about' }) %>

  <section class="page-hero">
    <div class="container">
      <h1>About TravelTrust</h1>
      <p class="page-subtitle">Protecting what matters for over 160 years.</p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="section section-light">
    <div class="container">
      <div class="about-story">
        <div class="about-image">
          <img src="/images/about.jpg" alt="TravelTrust history">
        </div>
        <div class="about-text">
          <h2>Our Story</h2>
          <p>Founded in 1853, TravelTrust has grown from a small regional insurer into one of the largest insurance companies in the United States. For over 160 years, we've been helping individuals, families, and businesses protect what matters most.</p>
          <p>Today, Travelers serves millions of customers across all 50 states and offers a wide range of insurance products — from auto and home to business and specialty coverage. We're proud to be consistently recognized for our financial strength, customer service, and innovation.</p>
          <p>Our commitment remains the same as it was on day one: to be there for our customers when they need us most, with integrity, reliability, and compassion.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Row -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">1853</span>
          <span class="stat-label">Founded</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">30M+</span>
          <span class="stat-label">Customers</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">50</span>
          <span class="stat-label">States</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">13,000+</span>
          <span class="stat-label">Employees</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Statement -->
  <section class="section section-navy">
    <div class="container mission-section">
      <h2 class="section-title white">Our Mission</h2>
      <blockquote class="mission-quote">
        <p>"To provide peace of mind to our customers by delivering exceptional insurance protection and service, every day and when it matters most."</p>
      </blockquote>
      <div class="mission-values">
        <div class="value-item">
          <i class="fas fa-handshake"></i>
          <h4>Integrity</h4>
          <p>Doing the right thing, always.</p>
        </div>
        <div class="value-item">
          <i class="fas fa-users"></i>
          <h4>Customer First</h4>
          <p>Every decision starts with our customers.</p>
        </div>
        <div class="value-item">
          <i class="fas fa-lightbulb"></i>
          <h4>Innovation</h4>
          <p>Continuously improving to serve better.</p>
        </div>
        <div class="value-item">
          <i class="fas fa-hand-holding-heart"></i>
          <h4>Community</h4>
          <p>Giving back to the communities we serve.</p>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

